        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は現在%2$@で実行されていません。"
          }
        }
      }
    },
    "%@ received an invalid request from AltServer." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha ricevuto una richiesta invalida da AltServer"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はAltServerから無効なリクエストを受け取りました。"
          }
        }
      }
    },
    "%@ requires %@ or later." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ requires %2$@ or later."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ richiede  %2$@ o successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は%2$@以降を必要とします。"
          }
        }
