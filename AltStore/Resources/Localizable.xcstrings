    "Your pledge is no longer active. Please renew it to continue using %@ normally." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo impegno non è più attivo. Rinnovalo per continuare ad usare %@ normalmente."
